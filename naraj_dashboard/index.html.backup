<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>FloodWatch — Flood information made easier</title>
<link rel="stylesheet" href="vendor/leaflet/leaflet.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="style.css" />
<link rel="stylesheet" href="public.css" />
</head>
<body class="public-body">

<header class="pub-header">
  <div class="pub-header-brand">
    <span class="pub-logo">FloodWatch</span>
    <span class="pub-tagline">Flood information made easier</span>
  </div>
  <a href="research.html" class="pub-research-link">Research / Technical View</a>
</header>

<nav class="pub-nav" id="pub-nav">
  <button class="pub-nav-btn active" data-pubtab="overview">Overview</button>
  <button class="pub-nav-btn" data-pubtab="floodmap">Flood Map</button>
  <button class="pub-nav-btn" data-pubtab="waterlevels">Water Levels</button>
  <button class="pub-nav-btn" data-pubtab="satellite">Satellite Evidence</button>
  <button class="pub-nav-btn" data-pubtab="pastfloods">Past Floods</button>
  <button class="pub-guide-btn" id="pub-guide-open-btn">? Guide</button>
</nav>

<div class="pub-tour-banner hidden" id="pub-tour-banner">
  <span>New to FloodWatch?</span>
  <button id="pub-tour-start-btn">Take a quick tour</button>
  <button id="pub-tour-skip-btn" class="pub-tour-skip">Skip</button>
</div>

<main class="pub-main">

  <!-- ===================== OVERVIEW ===================== -->
  <section class="pub-pane active" id="pub-overview">

    <div class="pub-controls-row">
      <div class="pub-search-box">
        <input type="text" placeholder="Search a location (demonstration mode)" disabled />
      </div>
      <div class="pub-event-select">
        <label for="pub-event-picker">Viewing event:</label>
        <select id="pub-event-picker"></select>
      </div>
    </div>
    <p class="pub-demo-note">Current demonstration area: <strong>Mahanadi Basin, Odisha</strong>. This
    product is designed to work at other locations as more monitoring sites are added.</p>

    <div class="pub-map-wrap">
      <div id="pub-map"></div>
      <button class="pub-whatami-btn" id="pub-whatami-btn">What am I looking at?</button>
    </div>

    <div class="pub-cards-row" id="pub-situation-cards"></div>

  </section>

  <!-- ===================== FLOOD MAP ===================== -->
  <section class="pub-pane" id="pub-floodmap">
    <div class="pub-card wide">
      <h2>Flood Map</h2>
      <p class="pub-subtext">The map below shows the potentially affected area identified from satellite
      observations, along with rivers, monitoring stations, and reference layers.</p>
      <div class="pub-map-wrap tall">
        <div id="pub-map-2"></div>
        <button class="pub-whatami-btn" id="pub-whatami-btn-2">What am I looking at?</button>
      </div>
      <div class="pub-layers-simple">
        <h3>Map layers <span class="info-icon-static" title="Turn map information on or off. Click 'What am I looking at?' for a plain-language explanation of what's currently shown.">i</span></h3>
        <div id="pub-layer-list-simple"></div>
        <button class="pub-more-layers-btn" id="pub-more-layers-btn">More layers (advanced)</button>
        <div id="pub-layer-list-advanced" class="hidden"></div>
      </div>
    </div>
  </section>

  <!-- ===================== WATER LEVELS ===================== -->
  <section class="pub-pane" id="pub-waterlevels">
    <div class="pub-card wide">
      <h2>River Water Level <span class="info-icon-static" title="Recorded water levels at a river monitoring station. Rising levels can indicate developing flood conditions.">i</span></h2>
      <p class="pub-subtext">This chart shows recorded water levels from the selected monitoring station.</p>
      <div class="pub-station-chips" id="pub-station-chips"></div>
      <canvas id="pub-wl-chart" height="130"></canvas>
      <p class="pub-caption" id="pub-wl-caption"></p>
    </div>
  </section>

  <!-- ===================== SATELLITE EVIDENCE ===================== -->
  <section class="pub-pane" id="pub-satellite">
    <div class="pub-card wide">
      <h2>Satellite Evidence <span class="info-icon-static" title="Radar satellites can observe the ground even through clouds and at night, which is useful for spotting surface changes during floods.">i</span></h2>
      <p class="pub-subtext">Radar satellites can observe changes in the Earth's surface even when clouds
      are present. Comparing observations from before and during a flood helps identify areas that may
      have become inundated.</p>
      <div class="sat-story-grid">
        <div class="sat-story-step">
          <div class="sat-story-label">Before</div>
          <div class="sat-story-date" id="sat-date-before">06 Aug</div>
          <img id="sat-img-before" class="sat-story-img" src="" alt="Before the event" />
        </div>
        <div class="sat-story-arrow">↓</div>
        <div class="sat-story-step">
          <div class="sat-story-label">During Event</div>
          <div class="sat-story-date" id="sat-date-during">18 Aug</div>
          <img id="sat-img-during" class="sat-story-img" src="" alt="During the event" />
        </div>
        <div class="sat-story-arrow">↓</div>
        <div class="sat-story-step">
          <div class="sat-story-label">Change Detected</div>
          <img id="sat-img-change" class="sat-story-img" src="" alt="Change detected" />
        </div>
        <div class="sat-story-arrow">↓</div>
        <div class="sat-story-step highlight">
          <div class="sat-story-label">Potential Flood Extent</div>
          <img id="sat-img-candidate" class="sat-story-img" src="" alt="Potential flood extent" />
        </div>
      </div>
      <button class="pub-tech-details-btn" id="sat-tech-toggle">Technical details</button>
      <div class="pub-tech-details hidden" id="sat-tech-content"></div>
    </div>
  </section>

  <!-- ===================== PAST FLOODS ===================== -->
  <section class="pub-pane" id="pub-pastfloods">
    <div class="pub-card wide">
      <h2>Past Floods — August 2022 <span class="info-icon-static" title="Browse dates from a real historical flood event to see how conditions changed over time.">i</span></h2>
      <p class="pub-subtext">Browse available historical flood dates for the current demonstration area.</p>
      <div id="pub-past-floods-list"></div>
    </div>
  </section>

  <!-- ===================== GUIDE DRAWER ===================== -->
  <div class="guide-backdrop hidden" id="guide-backdrop">
    <div class="guide-drawer">
      <div class="guide-drawer-header">
        <h2>Understanding FloodWatch</h2>
        <button class="guide-close-btn" id="guide-close-btn" aria-label="Close guide">✕</button>
      </div>
      <div class="guide-drawer-body">
        <p class="guide-intro">FloodWatch combines river-level records, satellite observations, terrain
        information and historical flood maps to help people understand flood events.</p>

        <div class="guide-item">
          <div class="guide-item-title">🌊 Potentially Affected Area</div>
          <p><strong>What is it?</strong> An area identified by the analysis as potentially affected by
          flooding during the selected event.</p>
          <p><strong>What should I remember?</strong> It represents an analytical estimate based on the
          available evidence and should not be interpreted as an emergency evacuation boundary.</p>
        </div>

        <div class="guide-item">
          <div class="guide-item-title">📈 River Water Level</div>
          <p><strong>What is it?</strong> The recorded water level at a river monitoring station.</p>
          <p><strong>Why is it useful?</strong> Changes in river level help us understand how conditions
          developed before, during and after a flood event.</p>
        </div>

        <div class="guide-item">
          <div class="guide-item-title">🛰 Satellite Evidence</div>
          <p><strong>What is it?</strong> Radar satellites observe the Earth's surface from space.</p>
          <p><strong>Why use radar?</strong> Radar observations can work during both day and night and can
          observe the surface through cloud cover, which is especially useful during heavy rainfall and
          floods.</p>
        </div>

        <div class="guide-item">
          <div class="guide-item-title">🗺 Historical Flood Extent</div>
          <p><strong>What is it?</strong> A map showing areas recorded as inundated during a past flood
          event.</p>
          <p><strong>Why is it useful?</strong> It helps users compare satellite-based analysis with
          historical flood information.</p>
        </div>

        <div class="guide-item">
          <div class="guide-item-title">⛰ Terrain / Elevation</div>
          <p><strong>What is it?</strong> Information describing whether land is relatively higher or
          lower.</p>
          <p><strong>Why is it useful?</strong> Low-lying areas can be more susceptible to water
          accumulation, although elevation alone does not determine whether an area will flood.</p>
        </div>

        <div class="guide-item">
          <div class="guide-item-title">📍 Monitoring Station</div>
          <p><strong>What is it?</strong> A location where river water-level observations are recorded.
          You can select available stations under Water Levels and view their historical records.</p>
        </div>

        <button class="guide-tour-again-btn" id="guide-tour-again-btn">Start tour again</button>

        <p class="guide-footer-note">Want the full technical methodology and validation details? Open the
        <a href="research.html">Research / Technical View</a>.</p>
      </div>
    </div>
  </div>

  <!-- ===================== FIRST-TIME TOUR ===================== -->
  <div class="tour-backdrop hidden" id="tour-backdrop">
    <div class="tour-modal">
      <div class="tour-step-count" id="tour-step-count">Step 1 of 5</div>
      <h3 id="tour-title"></h3>
      <p id="tour-text"></p>
      <div class="tour-controls">
        <button id="tour-skip-btn" class="tour-skip-btn">Skip</button>
        <button id="tour-next-btn" class="tour-next-btn">Next</button>
      </div>
    </div>
  </div>

</main>

<footer class="pub-footer">

  FloodWatch — a flood information demonstration system. Current demonstration area: Mahanadi Basin,
  Odisha. <a href="research.html">Research / Technical View</a>
</footer>

<script src="vendor/leaflet/leaflet.js"></script>
<script src="vendor/chartjs/chart.umd.js"></script>
<script src="public.js"></script>
</body>
</html>
